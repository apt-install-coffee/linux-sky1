From ba12b13de97ac21291353aad4011fc7962204401 Mon Sep 17 00:00:00 2001
From: Jordan McCallum <apt-install-coffee@proton.me>
Date: Thu, 20 Aug 2026 16:55:43 +1000
Subject: [PATCH 143/145] v7.2: adapt Sky1 platform drivers to updated kernel
 APIs

- pwm-sky1: global screen_info was removed on arm64; detect UEFI-init'd
  PWM from the controller register instead.
- clk-sky1-audss: clk_ops.round_rate/divider_round_rate removed; use
  determine_rate/divider_determine_rate.
- armchina-npu: pm_runtime_put() now returns void; use pm_runtime_put_sync()
  where the return value is checked.
- cix-mailbox: drop the include of the removed internal mailbox.h (its
  MBOX_* defines now live in <linux/mailbox_controller.h>).
- cpufreq: policy->max_freq_req is an embedded struct in v7.2, not a
  pointer; pass its address.
- reset/core: restore the dev_fwnode() local the fork's lookup fallback
  needs (the fork re-adds the reset lookup-table API).
- media/mvx: strncpy() removed -> strscpy(); vb2 wait_prepare/wait_finish
  ops removed -> set vb2_queue.lock so vb2 manages the session mutex.
---
 drivers/clk/cix/clk-sky1-audss.c              | 10 ++--
 drivers/cpufreq/cpufreq.c                     |  2 +-
 drivers/mailbox/cix-mailbox.c                 |  2 -
 .../media/platform/cix/if/v4l2/mvx_ext_v4l2.c |  3 +-
 .../platform/cix/if/v4l2/mvx_v4l2_vidioc.c    | 54 ++-----------------
 drivers/misc/armchina-npu/sky1/sky1.c         |  4 +-
 drivers/pwm/pwm-sky1.c                        | 10 ++--
 drivers/reset/core.c                          |  1 +
 8 files changed, 23 insertions(+), 63 deletions(-)

diff --git a/drivers/clk/cix/clk-sky1-audss.c b/drivers/clk/cix/clk-sky1-audss.c
index 174058167d56..637e7d9d98b9 100644
--- a/drivers/clk/cix/clk-sky1-audss.c
+++ b/drivers/clk/cix/clk-sky1-audss.c
@@ -303,13 +303,13 @@ static unsigned long sky1_audss_div_recalc_rate(struct clk_hw *hw,
 				   div->flags, div->width);
 }
 
-static long sky1_audss_div_round_rate(struct clk_hw *hw, unsigned long rate,
-				      unsigned long *prate)
+static int sky1_audss_div_determine_rate(struct clk_hw *hw,
+					 struct clk_rate_request *req)
 {
 	struct clk_divider *div = to_clk_divider(hw);
 
-	return divider_round_rate(hw, rate, prate, div->table,
-				  div->width, div->flags);
+	return divider_determine_rate(hw, req, div->table,
+				      div->width, div->flags);
 }
 
 static int sky1_audss_div_set_rate(struct clk_hw *hw, unsigned long rate,
@@ -340,7 +340,7 @@ static int sky1_audss_div_set_rate(struct clk_hw *hw, unsigned long rate,
 
 static const struct clk_ops sky1_audss_div_ops = {
 	.recalc_rate = sky1_audss_div_recalc_rate,
-	.round_rate = sky1_audss_div_round_rate,
+	.determine_rate = sky1_audss_div_determine_rate,
 	.set_rate = sky1_audss_div_set_rate,
 };
 
