@@ -15,7 +15,6 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pwm.h>
-#include <linux/screen_info.h>
 #include <linux/slab.h>
 #include <linux/acpi.h>
 #include <linux/reset.h>
@@ -218,8 +217,13 @@ static int pwm_sky1_probe(struct platform_device *pdev)
 
 	pwmcr = readl(sky1->mmio_base + TCTL);
 
-	/* Check if PWM was already initialized by UEFI */
-	if (screen_info.lfb_linelength && (pwmcr & (PWM_MODE | ENABLE | ENPWM)))
+	/*
+	 * Check if PWM was already initialized by UEFI. The global screen_info
+	 * was removed on arm64 in v7.x, so rely on the controller state: if the
+	 * hardware is already in PWM mode and enabled, leave it untouched to
