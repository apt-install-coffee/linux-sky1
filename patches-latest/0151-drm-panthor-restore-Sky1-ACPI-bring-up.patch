From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jordan McCallum <apt-install-coffee@proton.me>
Date: Tue, 3 Nov 2026 16:00:00 +1000
Subject: [PATCH] drm/panthor: restore Sky1 GPU bring-up under ACPI

The v7.2 rebase (0141) dropped the fork's Panthor ACPI support and the
Sky1 MMIO resource split, assuming device-tree boot.  Orion O6 boots
ACPI, so CIXH5000 never binds, and the earlier hand-written restore patch
read GPU_ID from resource 0 (RCSU) instead of resource 1 (GPU registers).

Restore the full bring-up:

- ACPI device match, positional IRQ lookup, and raw-SMC power-on.
- Sky1 resource 0 = RCSU, resource 1 = GPU registers.
- Named Sky1 clocks from the ACPI CLKT bridge (gpu_clk_core,
  gpu_clk_stacks, gpu_clk_200M, gpu_clk_400M), with mainline fallbacks.
- GPU reset and qchannel clock-gating before the first register access.
- RCSU shader-harvesting mask.
- Keep ACPI devfreq disabled for now; the resume path enables the clocks.
- Print a decisive GPU_ID diagnostic.

Based on the fork's 0006/0096 patches and the local v3 ACPI restore
patch, rebased onto the post-0141 v7.2 tree.
---
diff --git a/drivers/gpu/drm/panthor/panthor_devfreq.c b/drivers/gpu/drm/panthor/panthor_devfreq.c
index 2249b41ca4af..dfb7c4d3e444 100644
--- a/drivers/gpu/drm/panthor/panthor_devfreq.c
+++ b/drivers/gpu/drm/panthor/panthor_devfreq.c
@@ -2,6 +2,7 @@
 /* Copyright 2019 Collabora ltd. */
 
 #include <linux/clk.h>
+#include <linux/acpi.h>
 #include <linux/devfreq.h>
 #include <linux/devfreq_cooling.h>
 #include <linux/platform_device.h>
@@ -148,6 +149,26 @@ int panthor_devfreq_init(struct panthor_device *ptdev)
 	unsigned long freq = ULONG_MAX;
 	int ret;
 
+	/*
+	 * ACPI boot: there is no DT OPP table and no regulator bindings, and
+	 * devm_pm_opp_of_add_table() would fail the probe. Skip devfreq
+	 * entirely and run at the frequency configured by firmware; SCMI
+	 * perf-domain DVFS is not wired up on ACPI yet. Install a zeroed
+	 * panthor_devfreq so the suspend/resume/busy-recording helpers stay
+	 * NULL-safe (they all guard on pdevfreq->devfreq).
+	 */
+	if (!ptdev->base.dev->of_node &&
+	    has_acpi_companion(ptdev->base.dev)) {
+		ptdev->devfreq = drmm_kzalloc(&ptdev->base,
+					      sizeof(*ptdev->devfreq),
+					      GFP_KERNEL);
+		if (!ptdev->devfreq)
+			return -ENOMEM;
+
+		drm_info(&ptdev->base, "ACPI boot: devfreq disabled\n");
+		return 0;
+	}
+
 	pdevfreq = drmm_kzalloc(&ptdev->base, sizeof(*ptdev->devfreq), GFP_KERNEL);
 	if (!pdevfreq)
 		return -ENOMEM;
diff --git a/drivers/gpu/drm/panthor/panthor_device.c b/drivers/gpu/drm/panthor/panthor_device.c
index 9687c59de350..f4d4801f1248 100644
--- a/drivers/gpu/drm/panthor/panthor_device.c
+++ b/drivers/gpu/drm/panthor/panthor_device.c
@@ -5,7 +5,12 @@
 /* Copyright 2025 ARM Limited. All rights reserved. */
 
 #include <linux/clk.h>
+#include <linux/acpi.h>
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/io.h>
 #include <linux/mm.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
@@ -27,27 +32,177 @@
 #include "panthor_pwr.h"
 #include "panthor_sched.h"
 
+/*
+ * Sky1 GPU power-on via raw SMC SCMI call to TF-A.
+ *
+ * Under DT, the smc_devpd power-domain provider sends SCMI
+ * POWER_STATE_SET to TF-A via SMC function 0xc2000001 with shared memory
+ * at 0x84380000. Under ACPI there is no smc_devpd, and TF-A's SCMI power
+ * handler is a stub that returns success without touching hardware, so
+ * the raw SMC call is made directly from the driver.
+ *
+ * TF-A not only powers the GPU domain but also configures the IDM
+ * (Interconnect Domain Manager) to allow non-secure (Linux) access to
+ * GPU registers. Without this, any GPU register read causes an
+ * unrecoverable SError once the domain is powered, and a bus error while
+ * it is off.
+ */
+#define SKY1_SMC_SCMI_FUNC_ID		0xc2000001
+#define SKY1_SMC_SCMI_SHMEM_PHYS	0x84380000UL
+#define SKY1_SMC_SCMI_SHMEM_SIZE	0x80
+#define SKY1_PD_GPU			21
+
+/* SCMI shared memory offsets */
+#define SCMI_SHMEM_CHAN_STATUS		0x04
+#define SCMI_SHMEM_FLAGS		0x10
+#define SCMI_SHMEM_LENGTH		0x14
+#define SCMI_SHMEM_MSG_HEADER		0x18
+#define SCMI_SHMEM_MSG_PAYLOAD		0x1c
+
+static int sky1_smc_scmi_power_set(struct device *dev, u32 domain, u32 state)
+{
+	void __iomem *shmem;
+	struct arm_smccc_res res;
+	u32 msg_header, resp_status;
+	int timeout = 1000;
+
+	shmem = ioremap(SKY1_SMC_SCMI_SHMEM_PHYS, SKY1_SMC_SCMI_SHMEM_SIZE);
+	if (!shmem)
+		return -ENOMEM;
+
+	/* Wait for channel free */
+	while (!(ioread32(shmem + SCMI_SHMEM_CHAN_STATUS) & BIT(0))) {
+		if (--timeout <= 0) {
+			dev_err(dev, "SCMI SMC channel busy timeout\n");
+			iounmap(shmem);
+			return -ETIMEDOUT;
+		}
+		udelay(10);
+	}
+
+	/* Clear channel status */
+	iowrite32(0, shmem + SCMI_SHMEM_CHAN_STATUS);
+
+	/* Polling mode (no interrupt) */
+	iowrite32(0, shmem + SCMI_SHMEM_FLAGS);
+
+	/*
+	 * Message header:
+	 *   Bits  0-7:  MSG_ID = 0x04 (POWER_STATE_SET)
+	 *   Bits  8-9:  MSG_TYPE = 0 (command)
+	 *   Bits 10-17: PROTOCOL_ID = 0x11 (POWER)
+	 *   Bits 18-27: TOKEN = 0
+	 */
+	msg_header = 0x04 | (0x11 << 10);
+	iowrite32(msg_header, shmem + SCMI_SHMEM_MSG_HEADER);
+
+	/* Payload: flags(4) + domain(4) + state(4) = 12 bytes */
+	iowrite32(0, shmem + SCMI_SHMEM_MSG_PAYLOAD);		/* flags: sync */
+	iowrite32(domain, shmem + SCMI_SHMEM_MSG_PAYLOAD + 4);	/* domain_id */
+	iowrite32(state, shmem + SCMI_SHMEM_MSG_PAYLOAD + 8);	/* power_state */
+
+	/* Length = msg_header(4) + payload(12) = 16 */
+	iowrite32(16, shmem + SCMI_SHMEM_LENGTH);
+
+	/* SMC call: param_page = phys >> 12, param_offset = phys & 0xFFF */
+	arm_smccc_smc(SKY1_SMC_SCMI_FUNC_ID,
+		      SKY1_SMC_SCMI_SHMEM_PHYS >> 12,
+		      SKY1_SMC_SCMI_SHMEM_PHYS & 0xFFF,
+		      0, 0, 0, 0, 0, &res);
+
+	if (res.a0) {
+		dev_err(dev, "SCMI SMC returned error: 0x%lx\n", res.a0);
+		iounmap(shmem);
+		return -EIO;
+	}
+
+	/* Response: first word of payload is SCMI status */
+	resp_status = ioread32(shmem + SCMI_SHMEM_MSG_PAYLOAD);
+	iounmap(shmem);
+
+	if (resp_status != 0) {
+		dev_err(dev, "SCMI POWER_STATE_SET domain %u failed: %d\n",
+			domain, resp_status);
+		return -EIO;
+	}
+
+	dev_info(dev, "GPU power domain %u powered on via SMC SCMI\n", domain);
+	return 0;
+}
+
+bool panthor_is_sky1(struct panthor_device *ptdev)
+{
+	struct device *dev = ptdev->base.dev;
+
+	if (dev->of_node)
+		return of_device_is_compatible(dev->of_node, "arm,mali-valhall");
+
+	return has_acpi_companion(dev) &&
+	       acpi_dev_hid_uid_match(ACPI_COMPANION(dev), "CIXH5000", NULL);
+}
+
 static int panthor_clk_init(struct panthor_device *ptdev)
 {
-	ptdev->clks.core = devm_clk_get(ptdev->base.dev, NULL);
+	struct device *dev = ptdev->base.dev;
+	bool sky1 = panthor_is_sky1(ptdev);
+
+	/*
+	 * Sky1's ACPI CLKT bridge publishes the vendor clock names from the
+	 * DT binding.  Try those first, then fall back to the mainline names
+	 * and finally to an unnamed clock.  The core clock is optional on
+	 * Sky1: the firmware may leave it off and TCP/SCMI DVFS may own it.
+	 */
+	ptdev->clks.core = devm_clk_get_optional(dev, "gpu_clk_core");
 	if (IS_ERR(ptdev->clks.core))
-		return dev_err_probe(ptdev->base.dev,
-				     PTR_ERR(ptdev->clks.core),
-				     "get 'core' clock failed");
+		return dev_err_probe(dev, PTR_ERR(ptdev->clks.core),
+				     "get 'gpu_clk_core' clock failed");
+
+	if (!ptdev->clks.core) {
+		ptdev->clks.core = devm_clk_get_optional(dev, NULL);
+		if (IS_ERR(ptdev->clks.core))
+			return dev_err_probe(dev, PTR_ERR(ptdev->clks.core),
+					     "get 'core' clock failed");
+	}
 
-	ptdev->clks.stacks = devm_clk_get_optional(ptdev->base.dev, "stacks");
+	if (!ptdev->clks.core && !sky1)
+		return dev_err_probe(dev, -ENOENT, "get 'core' clock failed");
+
+	ptdev->clks.stacks = devm_clk_get_optional(dev, "gpu_clk_stacks");
 	if (IS_ERR(ptdev->clks.stacks))
-		return dev_err_probe(ptdev->base.dev,
-				     PTR_ERR(ptdev->clks.stacks),
-				     "get 'stacks' clock failed");
+		return dev_err_probe(dev, PTR_ERR(ptdev->clks.stacks),
+				     "get 'gpu_clk_stacks' clock failed");
+
+	if (!ptdev->clks.stacks) {
+		ptdev->clks.stacks = devm_clk_get_optional(dev, "stacks");
+		if (IS_ERR(ptdev->clks.stacks))
+			return dev_err_probe(dev, PTR_ERR(ptdev->clks.stacks),
+					     "get 'stacks' clock failed");
+	}
 
-	ptdev->clks.coregroup = devm_clk_get_optional(ptdev->base.dev, "coregroup");
+	ptdev->clks.coregroup = devm_clk_get_optional(dev, "coregroup");
 	if (IS_ERR(ptdev->clks.coregroup))
-		return dev_err_probe(ptdev->base.dev,
-				     PTR_ERR(ptdev->clks.coregroup),
+		return dev_err_probe(dev, PTR_ERR(ptdev->clks.coregroup),
 				     "get 'coregroup' clock failed");
 
-	drm_info(&ptdev->base, "clock rate = %lu\n", clk_get_rate(ptdev->clks.core));
+	if (sky1) {
+		ptdev->clks.backup[0] = devm_clk_get_optional(dev, "gpu_clk_200M");
+		if (IS_ERR(ptdev->clks.backup[0]))
+			return dev_err_probe(dev, PTR_ERR(ptdev->clks.backup[0]),
+					     "get 'gpu_clk_200M' clock failed");
+
+		ptdev->clks.backup[1] = devm_clk_get_optional(dev, "gpu_clk_400M");
+		if (IS_ERR(ptdev->clks.backup[1]))
+			return dev_err_probe(dev, PTR_ERR(ptdev->clks.backup[1]),
+					     "get 'gpu_clk_400M' clock failed");
+	}
+
+	if (ptdev->clks.core)
+		drm_info(&ptdev->base, "clock rate = %lu\n",
+			 clk_get_rate(ptdev->clks.core));
+	else
+		drm_warn(&ptdev->base,
+			 "no GPU core clock; running at firmware-configured rate\n");
+
 	return 0;
 }
 
@@ -55,12 +210,51 @@ static int panthor_init_power(struct device *dev)
 {
 	struct dev_pm_domain_list  *pd_list = NULL;
 
+	/*
+	 * ACPI boot (no DT): TF-A's SCMI power handler is a stub that returns
+	 * success without touching hardware, so power the GPU domain directly
+	 * with a raw SMC SCMI call before the first register access
+	 * (panthor_hw_init reads GPU_ID). Then detach any pm_domain the
+	 * driver core attached during ACPI enumeration (ACPI power resources
+	 * or firmware-backed genpd): those paths are stubbed on Sky1 and
+	 * would gate runtime PM on a domain that cannot actually power the
+	 * GPU. The GPU stays on for the device lifetime; runtime PM
+	 * transitions are no-ops for power.
+	 */
+	if (!dev->of_node && has_acpi_companion(dev)) {
+		int ret = sky1_smc_scmi_power_set(dev, SKY1_PD_GPU, 0);
+
+		if (ret)
+			return ret;
+
+		if (dev->pm_domain)
+			dev_pm_domain_detach(dev, false);
+
+		return 0;
+	}
+
 	if (dev->pm_domain)
 		return 0;
 
 	return devm_pm_domain_attach_list(dev, NULL, &pd_list);
 }
 
+static int panthor_resets_init(struct panthor_device *ptdev)
+{
+	struct device *dev = ptdev->base.dev;
+
+	if (!dev->of_node && has_acpi_companion(dev))
+		ptdev->gpu_reset = devm_reset_control_get_optional_exclusive(dev, "gpu_reset");
+	else
+		ptdev->gpu_reset = devm_reset_control_get_optional(dev, "gpu_reset");
+
+	if (IS_ERR(ptdev->gpu_reset))
+		return dev_err_probe(dev, PTR_ERR(ptdev->gpu_reset),
+				     "failed to get gpu_reset\n");
+
+	return 0;
+}
+
 void panthor_device_unplug(struct panthor_device *ptdev)
 {
 	/* This function can be called from two different path: the reset work
@@ -233,10 +427,34 @@ int panthor_device_init(struct panthor_device *ptdev)
 	if (ret)
 		return ret;
 
-	ptdev->iomem = devm_platform_get_and_ioremap_resource(to_platform_device(ptdev->base.dev),
-							      0, &res);
-	if (IS_ERR(ptdev->iomem))
-		return PTR_ERR(ptdev->iomem);
+	ret = panthor_resets_init(ptdev);
+	if (ret)
+		return ret;
+
+	if (panthor_is_sky1(ptdev)) {
+		struct platform_device *pdev = to_platform_device(ptdev->base.dev);
+
+		/* Sky1 uses resource 0 for RCSU and resource 1 for GPU regs. */
+		ptdev->iomem = devm_platform_get_and_ioremap_resource(pdev, 1, &res);
+		if (IS_ERR(ptdev->iomem)) {
+			dev_warn(ptdev->base.dev,
+				 "Sky1 GPU register resource 1 missing, falling back to resource 0\n");
+			ptdev->iomem = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+			if (IS_ERR(ptdev->iomem))
+				return PTR_ERR(ptdev->iomem);
+		} else {
+			ptdev->sky1_rcsu_reg = devm_platform_ioremap_resource(pdev, 0);
+			if (IS_ERR(ptdev->sky1_rcsu_reg)) {
+				dev_warn(ptdev->base.dev, "Sky1 RCSU resource 0 unavailable\n");
+				ptdev->sky1_rcsu_reg = NULL;
+			}
+		}
+	} else {
+		ptdev->iomem = devm_platform_get_and_ioremap_resource(
+			to_platform_device(ptdev->base.dev), 0, &res);
+		if (IS_ERR(ptdev->iomem))
+			return PTR_ERR(ptdev->iomem);
+	}
 
 	ptdev->phys_addr = res->start;
 
@@ -255,6 +473,36 @@ int panthor_device_init(struct panthor_device *ptdev)
 			return ret;
 	}
 
+	/*
+	 * Sky1 bring-up: power domain on -> clocks on -> IP reset -> qchannel
+	 * clock gating.  Power and clocks are handled above; finish the
+	 * sequence before panthor_hw_init() touches GPU_ID.
+	 */
+	if (panthor_is_sky1(ptdev)) {
+		if (ptdev->gpu_reset) {
+			ret = reset_control_assert(ptdev->gpu_reset);
+			if (ret) {
+				dev_err(ptdev->base.dev, "GPU reset assert failed: %d\n", ret);
+				goto err_rpm_put;
+			}
+
+			usleep_range(10, 20);
+
+			ret = reset_control_deassert(ptdev->gpu_reset);
+			if (ret) {
+				dev_err(ptdev->base.dev, "GPU reset deassert failed: %d\n", ret);
+				goto err_rpm_put;
+			}
+		}
+
+		if (ptdev->sky1_rcsu_reg) {
+			u32 pgctrl = readl(ptdev->sky1_rcsu_reg + 0x218);
+
+			pgctrl |= BIT(0);  /* QCHANNEL_CLOCK_GATE_ENABLE */
+			writel(pgctrl, ptdev->sky1_rcsu_reg + 0x218);
+		}
+	}
+
 	ret = panthor_hw_init(ptdev);
 	if (ret)
 		goto err_rpm_put;
