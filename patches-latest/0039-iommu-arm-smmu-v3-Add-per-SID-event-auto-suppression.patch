From b3a7e3aa411440fb318db7c6797ee541a2544333 Mon Sep 17 00:00:00 2001
From: Entrpi <entrpi@proton.me>
Date: Thu, 5 Feb 2026 10:33:37 +1100
Subject: [PATCH 039/145] iommu/arm-smmu-v3: Add per-SID event auto-suppression

Some SoCs have hardware blocks (e.g. PCIe DTI ATS masters) that
continuously generate SMMU faults on stream IDs shared with real
devices. These faults cannot be prevented from software when the
offending hardware's control registers are in a secure-only domain.

Add per-SID event tracking: after 10 events from the same stream ID,
suppress further logging for that SID to avoid flooding the console
and drowning out legitimate events from other streams.
---
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c | 37 ++++++++++++++++++++-
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h |  8 +++++
 2 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
index 7e2134e5e451..06d13c264519 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
@@ -2155,6 +2155,39 @@ static void arm_smmu_dump_event(struct arm_smmu_device *smmu, u64 *raw,
 	}
 }
 
+/*
+ * Per-SID event auto-suppression.  After SMMU_EVT_SUPPRESS_THRESHOLD events
+ * from the same stream ID, further events are silently dropped.  This handles
+ * hardware that generates continuous faults on SIDs that software cannot
+ * control (e.g. PCIe DTI ATS masters with secure-only registers).
+ *
+ * Returns true if the event should be suppressed.
+ */
+static bool arm_smmu_evt_suppressed(struct arm_smmu_device *smmu, u32 sid)
+{
+	int i, free_slot = -1;
+
+	for (i = 0; i < SMMU_EVT_SUPPRESS_SLOTS; i++) {
+		if (smmu->evt_suppress[i].count && smmu->evt_suppress[i].sid == sid) {
+			if (++smmu->evt_suppress[i].count == SMMU_EVT_SUPPRESS_THRESHOLD) {
+				dev_warn(smmu->dev,
+					 "auto-suppressing events for sid %#x (%u seen)\n",
+					 sid, smmu->evt_suppress[i].count);
+			}
+			return smmu->evt_suppress[i].count >= SMMU_EVT_SUPPRESS_THRESHOLD;
+		}
+		if (!smmu->evt_suppress[i].count && free_slot < 0)
+			free_slot = i;
+	}
+
+	/* New SID — start tracking */
+	if (free_slot >= 0) {
+		smmu->evt_suppress[free_slot].sid = sid;
+		smmu->evt_suppress[free_slot].count = 1;
+	}
+	return false;
+}
+
 static irqreturn_t arm_smmu_evtq_thread(int irq, void *dev)
 {
 	u64 evt[EVTQ_ENT_DWORDS];
@@ -2168,9 +2201,11 @@ static irqreturn_t arm_smmu_evtq_thread(int irq, void *dev)
 	do {
 		while (!queue_remove_raw(q, evt)) {
 			arm_smmu_decode_event(smmu, evt, &event);
+			if (arm_smmu_evt_suppressed(smmu, event.sid))
+				goto evt_next;
 			if (arm_smmu_handle_event(smmu, evt, &event))
 				arm_smmu_dump_event(smmu, evt, &event, &rs);
-
+evt_next:
 			put_device(event.dev);
 			cond_resched();
 		}
diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
index 4abefec37938..2e77883222a2 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
@@ -959,6 +959,14 @@ struct arm_smmu_device {
 
 	struct rb_root			streams;
 	struct mutex			streams_mutex;
+
+	/* Per-SID event suppression for noisy streams (e.g. PCIe DTI ATS) */
+#define SMMU_EVT_SUPPRESS_SLOTS		8
+#define SMMU_EVT_SUPPRESS_THRESHOLD	3
+	struct {
+		u32			sid;
+		u32			count;
+	} evt_suppress[SMMU_EVT_SUPPRESS_SLOTS];
 };
 
 struct arm_smmu_stream {
-- 
2.54.0

