+
+		ptdev->gpu_info.shader_present &= sky1_harvesting_core_mask;
+
+		drm_info(&ptdev->base,
+			 "sky1 harvesting: reg=0x%x core_mask=0x%llx",
+			 sky1_harvesting_reg_val, sky1_harvesting_core_mask);
+	}
 }
 
